#!/usr/bin/env python3
"""Stand-in for aws and az: records argv, prints a fixed help text."""
import json
import os
import sys

with open(os.environ['FAKE_CLI_LOG'], 'a', encoding='utf-8') as log:
    log.write(json.dumps([os.path.basename(sys.argv[0])] + sys.argv[1:]) + '\n')
if 'bogus' in sys.argv:
    print('invalid choice: bogus', file=sys.stderr)
    sys.exit(252 if os.path.basename(sys.argv[0]) == 'aws' else 2)
flags = '--region  --name  --output'
if 'prefixed' in sys.argv:
    flags = '--destination-port-ranges  --start-ip-address  --start-time'
print(f'usage: fake [options]\n  {flags}')
